# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# PyInstaller build output
build/
dist/
*.manifest

# Local app data / downloaded mods (large, may be copyrighted)
mod_samples/
*.zip
*.7z
*.rar

# Bundled third-party engine (built by tools/setup_holopatcher.py; not committed)
tools/HoloPatcher/
tools/.pykotor-src/
tools/.holopatcher-build/
# PyKotor source checkout made by the build workflow
.pykotor-src/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local secrets / config
.env
*.local.json

# Build log
build_log.txt

# Generated scrape/analysis data (regenerated by the analysis scripts; the app
# scrapes live at runtime and does not need these committed)
build_detail.json
mod_analysis.json
ordered_mods.json
backend_build_log.txt
tauri_build_log.txt

# ── Frontend (Tauri + React) ───────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/package-lock.json.bak
# Rust / Tauri build output
frontend/src-tauri/target/
frontend/src-tauri/gen/
# Sidecar binaries are produced at build time (PyInstaller), never committed
frontend/src-tauri/binaries/

# Scratch output from build-guide scraping sessions
.playwright-mcp/
